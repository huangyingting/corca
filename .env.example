# Database Configuration
# Local development (SQLite):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL):
# DATABASE_URL="postgresql://cortex:password@localhost:5432/cortex?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-32-byte-base64url-secret"

# Account Admission Policy ("invitation-only" | "public")
ACCOUNT_ADMISSION_MODE="invitation-only"

# Optional Google OAuth Provider
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional Azure OpenAI Configuration for Orca AI Assistant
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT="gpt-6.1-sol"
AZURE_OPENAI_API_VERSION="2024-10-21"
